  "meta": {
    "description": "Curated emergency-care capability profiles for Bengaluru hospitals.",
    "provenance_model": {
      "capability": "CURATED - facility capability (cath lab, stroke unit, trauma centre, blood bank) compiled from public hospital listings and institutional profiles. Stable over months; verifiable by a judge.",
