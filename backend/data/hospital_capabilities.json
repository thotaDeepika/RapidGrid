    },
    "scale": "capability scores are 0.0-1.0, representing suitability for receiving that emergency category",
    "emergency_receiving": "false for facilities that do not accept undifferentiated emergency ambulance arrivals (oncology centres, maternity-only, day-surgery). These are excluded from trauma/cardiac/stroke routing.",
    "last_reviewed": "2026-09-06"
  },

